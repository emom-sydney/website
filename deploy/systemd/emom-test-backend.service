[Unit]
Description=EMOM Backend (test)
After=network.target

[Service]
Type=simple
User=emom
Group=www-data
WorkingDirectory=/opt/emom/website-test
EnvironmentFile=/etc/emom/forms_bridge_test.env
ExecStart=/opt/emom/website-test/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5002 backend.wsgi:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
